# 模型目录的路径
# 新增服务端口变量
service_port=9998
LLM_DATA_DIR=/logs
# 镜像设置
IMAGE=harbor.vastaitech.com/ai_deliver/xinference_vacc:VVI-25.12.SP2
## 如果是arm 平台，公版的镜像是 harbor.vastaitech.com/ai_deliver/xinference_vacc:VVI-25.12.SP2_arm
# 参数设置
model_name=Qwen3-Thinking
model_directory=Qwen3-30B-A3B-Thinking-2507-FP8
GPU_LIST=20,21,22,23
instance_nums=1
