# 模型目录的路径
# 新增服务端口变量
service_port=9998
LLM_DATA_DIR=/logs
# 镜像设置
IMAGE=harbor.vastaitech.com/ai_deliver/xinference_vacc:VVI-25.12.SP2
## 如果是arm 平台，公版的镜像是 harbor.vastaitech.com/ai_deliver/xinference_vacc:VVI-25.12.SP2_arm
# 参数设置
model_name=Qwen3-Thinking
model_directory=Qwen3-30B-A3B-Thinking-2507-FP8
GPU_LIST=20,21,22,23
instance_nums=1
#text2vec模型目录的路径
EMB_DATA_DIR=/disk/models
RERANK_DATA_DIR=/disk/models
# 参数设置
embedding_model_name=bge-m3
embedding_model_directory=bge-m3
embedding_tp=1 
##embedding_tp=1 /2/ 4
embedding_GPUs=0,1
embedding_instance_nums=2

rerank_model_name=bge-reranker-v2-m3
rerank_model_directory=bge-reranker-v2-m3
# embedding_model_name=Qwen3-Embedding-0.6B
# embedding_model_directory=Qwen3-Embedding-0.6B
#rerank_model_name=Qwen3-Reranker-0.6B
#rerank_model_directory=Qwen3-Reranker-0.6B
rerank_tp=1
##rerank_tp=1 /2/ 4
rerank_GPUs=2,3
rerank_instance_nums=2